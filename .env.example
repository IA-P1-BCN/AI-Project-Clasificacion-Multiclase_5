# Copy this file to .env and adjust values as needed.
# docker compose reads .env automatically (it is optional).

# --- Database (MySQL 8.0 service in docker-compose.yml; ticket #37) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=multiclass
MYSQL_USER=app
MYSQL_PASSWORD=app
DATABASE_URL=mysql+pymysql://app:app@db:3306/multiclass
# Host port published for MySQL. Change it if 3306 is taken (for example by a local MySQL).
# MYSQL_PORT=3307

# --- Application services (docker-compose.yml; ticket #38) ---
# Path to the exported model artifact inside the container (#32).
MODEL_PATH=/app/models/model.joblib
# A/B test between two models (#52). MODEL_B_PATH is the challenger (export it with
# src/export_challenger.py); AB_TRAFFIC_B is the share of requests it receives (0 to 1).
# 0 disables the test: every request goes to the main model.
MODEL_B_PATH=/app/models/model_b.joblib
AB_TRAFFIC_B=0
# Backend API URL the frontend uses. Compose resolves "api" to the backend service.
API_URL=http://api:8000
